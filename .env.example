# Octane server root URL; do not include /api/... paths
OCTANE_BASE_URL=https://your-octane-server.example.com
OCTANE_SHARED_SPACE_ID=1001
OCTANE_WORKSPACE_ID=1002

# API access key generated in Octane
OCTANE_CLIENT_ID=your-client-id
OCTANE_CLIENT_SECRET=your-client-secret

# Export settings
OCTANE_OUTPUT_FILE=octane_tests_export.xlsx
OCTANE_PAGE_SIZE=200
OCTANE_REQUEST_TIMEOUT=45
OCTANE_VERIFY_TLS=true

# Optional shared query fallback (used for either collection unless overridden).
# The exporter automatically wraps query expressions in double quotes.
# Example: owner EQ {id EQ 54010}
OCTANE_TEST_QUERY=

# Optional independent filters; these take precedence over OCTANE_TEST_QUERY.
# Leave blank to inherit OCTANE_TEST_QUERY, or leave all three blank to export all.
OCTANE_MANUAL_TEST_QUERY=
OCTANE_GHERKIN_TEST_QUERY=
